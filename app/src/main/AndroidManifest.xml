<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InstantMechanicAssignment">
        <activity
            android:name=".presentation.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.InstantMechanicAssignment">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.InstantMechanicAssignment" />
        <activity
            android:name=".presentation.login.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.InstantMechanicAssignment" />
        <activity
            android:name=".presentation.signup.SignupActivity"
            android:exported="false"
            android:theme="@style/Theme.InstantMechanicAssignment" />
        <activity
            android:name=".presentation.home.HomeActivity"
            android:exported="false"
            android:theme="@style/Theme.InstantMechanicAssignment" />
        <activity
            android:name=".presentation.detail.GarageDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.InstantMechanicAssignment" />
        <activity
            android:name=".presentation.request.RequestServiceActivity"
            android:exported="false"
            android:theme="@style/Theme.InstantMechanicAssignment" />
        <activity
            android:name=".presentation.bookings.BookingsActivity"
            android:exported="false"
            android:theme="@style/Theme.InstantMechanicAssignment" />
        <activity
            android:name=".presentation.bookings.BookingDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.InstantMechanicAssignment" />
        <activity
            android:name=".presentation.messages.MessagesActivity"
            android:exported="false"
            android:theme="@style/Theme.InstantMechanicAssignment" />
        <activity
            android:name=".presentation.profile.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.InstantMechanicAssignment" />
    </application>

</manifest>